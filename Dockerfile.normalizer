FROM golang:1.26 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -a -o normalizer ./cmd/normalizer/
RUN CGO_ENABLED=0 GOOS=linux go build -a -o wrapper ./cmd/wrapper/

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/normalizer .
COPY --from=builder /workspace/wrapper .
USER 65532:65532
ENTRYPOINT ["/normalizer"]
